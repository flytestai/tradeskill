# 飞书本地配置模板（复制为 local_config.env 并填入真实值）
# 说明：data/local_config.env 已被 gitignore，不会入库；本 example 可入库作为说明。
# 每行 KEY=VALUE，# 开头为注释

# wu2198五号群（拉取消息的源群）chat_id
WU2198_CHAT_ID=

# VIP 消息推送 / 通用问答回复目标群（荔枝种植交流群）chat_id
VIP_PUSH_CHAT_ID=

# 飞书机器人私信接收人的 open_id
USER_OPEN_ID=

# 可选：VIP 消息标记词，多个用英文逗号分隔；缺省为「仅TA的真爱粉可见」
# VIP_MARKERS=仅TA的真爱粉可见
