# 二进制数据库文件，不纳入 git
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm

# 同步错误日志（每设备运行时状态，不纳入 git）
data/sync_errors.log
data/sync_errors.log.old

# 运行时临时/状态文件（每设备运行时状态，不纳入 git；含锁、心跳、缓存、临时输出）
data/_*

# 本地敏感配置（chat_id/open_id 等，不纳入 git）
data/local_config.env

# 提醒触发状态（每设备运行时状态，不纳入 git）
data/alert_state.txt
data/position_state.txt
data/price_alerts.json

# 临时脚本
scripts/bulk_*.py
scripts/_*.py
scripts/_*.txt

# 生成的 HTML 报告（每次重新生成即可）
scripts/kol_analysis_*.html

# Python 缓存
__pycache__/
*.pyc

# 荔枝群问答运行时状态（含用户 open_id 等个人数据，不纳入 git）
data/group_qa_queue.json
data/group_qa_answered.json

# 运行时下载的图片缓存
assets/feishu_images/

# 健康监控配置（含 API Key，不纳入 git）
data/monitor.env
data/_health_monitor*.log
data/_run_health_monitor.cmd

# ---- 服务器特有（部署时生成，不入库）----
.env
.env.runtime
vendor/
data.hostbak-*/
scripts/deploy/_run_*.sh

# 波浪上下文临时产物与缓存
data/_elliott_ctx_*.md
data/_elliott_ctx_*.txt

# 关键位数据日期（部署同步会刷新 mtime，故用内容记录真实日期）
data/level_asof.txt

# 状态文件损坏留证（safe_json 自动生成）
data/*.corrupt-*
