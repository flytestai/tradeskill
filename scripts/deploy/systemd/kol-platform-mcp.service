# KOL Skills Platform —— MCP 接口服务（宿主 venv + systemd）
#
# 供任意支持 MCP 的 Agent 调用（蜜蜂 Bee / WorkBuddy / Claude Code / Cursor ...）
# 传输：streamable-http
#
# 安装：
#   sudo cp kol-platform-mcp.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now kol-platform-mcp
#   或直接跑：bash scripts/deploy/deploy_mcp_fix.sh --install-service
#
# 接入方式：
#   蜜蜂      mcp_manage(action="upsert", name="kol-platform",
#                       transport="streamable-http", url="http://<host>:8021/mcp")
#   WorkBuddy ~/.workbuddy/connectors/*/mcp.json 增加：
#             {"kol-platform": {"type":"streamableHttp",
#                               "url":"http://<host>:8021/mcp","timeout":30000}}
#
# ⚠️ 2026-09-20 重写要点（与旧版逐条对应）
#   1) 旧版 User=kol / WorkingDirectory=/opt/kol-opinion-analyzer 是**另一台机器**
#      的路径（kol 用户也不存在）→ 单元根本起不来。现对齐实际环境：
#      ubuntu / /opt/kol-skills-platform（与 kol-platform.service 一致）。
#   2) 旧版 ExecStart=/usr/bin/python3 —— 系统 python 里**没有 mcp SDK**
#      （实测 ModuleNotFoundError）→ 必须用 .venv-host 的解释器。
#   3) 旧版端口 8001，而 .env 里 PLATFORM_MCP_PORT=8021，preflight 也探 8021
#      → 现已统一为 8021（显式 --port，不依赖环境变量默认值）。
#   4) 旧版 StandardOutput=append:/var/log/kol-platform/... 而该目录不存在
#      → systemd 起服务时会因无法打开日志文件而失败。现改用 journal
#      （journalctl -u kol-platform-mcp），并显式创建日志目录作为兜底。
#   5) 数据目录**只读挂载**的历史坑已由 api/config.py 的 mode=ro&immutable=1
#      解决，故这里给整机 ProtectSystem 加固后仍可正常读库。
#   6) Restart=always + StartLimit* —— 崩溃自愈；内存仅 956MB，故加
#      MemoryMax 防 MCP 跑飞把 REST/nginx 一起拖垮。

[Unit]
Description=KOL Skills Platform (MCP server)
Documentation=https://github.com/flytestai/tradeskill
After=network-online.target
Wants=network-online.target
# REST 与本服务共享 data/，先起 REST 不影响 MCP，但同属一个平台，便于一起停止
PartOf=kol-platform.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
# ⚠️ 必须是 scripts/：ExecStart 用 `-m api.mcp_server` 导入的是 scripts/ 下的
#    api 包。数据路径不依赖 cwd（config.py 用 __file__ 推导 SKILL_DIR），
#    故这里只需要保证包可导入。
WorkingDirectory=/opt/kol-skills-platform/scripts

Environment=TZ=Asia/Shanghai
# 与 REST 完全一致的配置来源（否则 MCP 会读到另一套 LLM / API Key）
EnvironmentFile=-/opt/kol-skills-platform/.env
EnvironmentFile=-/opt/kol-skills-platform/data/local_config.env
Environment=BEE_CHANNEL=http
Environment=BEE_FALLBACK_LOCAL=0
Environment=PLATFORM_MCP_PORT=8021

ExecStart=/opt/kol-skills-platform/.venv-host/bin/python -m api.mcp_server --http --host 127.0.0.1 --port 8021

Restart=always
RestartSec=5
# 崩溃循环保护：5 分钟内最多重启 5 次
StartLimitBurst=5
StartLimitIntervalSec=300

# 内存上限（宿主仅 956MB，REST+MCP+trade365 需共存）
MemoryHigh=280M
MemoryMax=400M

# 日志走 journal，避免因日志目录不存在而启动失败
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kol-platform-mcp

# ---- 安全加固 ----
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# MCP 只读数据与同步目录（不写库）
ReadOnlyPaths=/opt/kol-skills-platform/data /opt/kol-skills-platform/sync

[Install]
WantedBy=multi-user.target
