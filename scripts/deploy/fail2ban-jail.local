# ============================================================================
# fail2ban：SSH 防护
#
# 安装位置：/etc/fail2ban/jail.local
# 部署方式：cp scripts/deploy/fail2ban-jail.local /etc/fail2ban/jail.local
#           systemctl restart fail2ban
#
# 背景：2026-09-19 实测该服务器有 72,320 次 root 密码暴力破解尝试，
#       且 6 次成功登录来自 3 个不明 IP。当日完成 SSH 加固
#       （禁用密码、仅公钥）+ 本 jail 配置。
# ============================================================================
#
# ⚠️ 两个实战教训（都是"配了但没生效"）
# ---------------------------------------------------------------------------
# 【教训 1】加固后攻击形态变了，标准 filter 覆盖不到
#   SSH 加固前：攻击者发 "Failed password for root from <ip>"
#              → 标准 sshd filter 能匹配，会被封。
#   加固后：密码认证已禁用，攻击者建立连接后发现只支持公钥，
#           立即断开 → 日志变成
#              "Connection closed by authenticating user root <ip> [preauth]"
#           → 标准 filter **不匹配**，于是持续连接却不被封。
#   实测：108.165.164.23 出现 3499 次、92.118.39.77 出现 425 次，
#         均未被封。
#
#   解决：**内置 filter 也不覆盖这种形态** —— 实测 normal/ddos/extra/
#         aggressive 四种模式对该行**全部 0 matched**，故必须自研。
#         见 scripts/deploy/fail2ban-sshd-closed.conf（配套 [sshd-closed] jail）
#
#   ⚠️ 排查中连踩两坑，都属"配了但没生效"：
#     坑 1 双重转义：先用 Python 生成配置，\S \d 落盘成了**字面反斜杠**
#          → 正则永远匹配不上；而 jail 仍显示 active，
#            只有 `Total failed: 0` 暴露了问题。
#     坑 2 误判内置能力：一度以为 `sshd[mode=aggressive]` 够用 ——
#          它整体显示 175784 matched，但那是匹配了**别的行**；
#          用单行测试目标日志行才证明是 0 matched。
#     → 教训：**必须用"单行 + 目标日志行"验证**。
#       整体匹配数、jail 是否 active，都不能证明它真的生效。
#
# 【教训 2】backend 与"日志时区"会让 filter 静默失效
#   · backend：旧版 fail2ban(0.10.2) 的 `auto` 不可靠，显式用 `polling`。
#   · ★ 时区：rsyslog 在**进程启动时缓存时区**。
#     2026-09-19 改宿主机时区（US/Eastern → Asia/Shanghai）后，
#     只重启了 cron、**漏了 rsyslog** → 它继续用旧时区写日志
#     （日志 `05:46` 而宿主 `17:46`）→ fail2ban 按宿主机时区解析，
#     判定为"12 小时前"，**超出 findtime 而被全部忽略**。
#     症状极具迷惑性：fail2ban-regex 能匹配上千行（该工具不查 findtime），
#     但服务端 `Total failed` 恒为 0。
#     修复：改时区后**必须同时重启 rsyslog**（及其它缓存时区的常驻进程）。
#
# 验证方法（必须做，不能只看 active）
#   1) 格式验证：fail2ban-regex /var/log/auth.log 'sshd[aggressive]'
#   2) ★ 注入验证：往 /var/log/auth.log 追加一条已知恶意行，等几秒，
#      确认 `Total failed` 增加且该 IP 被封。
#      —— 这一步才能证明"真的在工作"，而不是"配置存在"。
#      2026-09-19 正是靠它才发现整个防护是失效的。
# ============================================================================

[DEFAULT]
bantime  = 7200
findtime = 600
maxretry = 5
backend  = polling
# 本机/内网永不封禁（防自锁）
ignoreip = 127.0.0.1/8 ::1

# 标准模式：Failed password 等（加固前的主要形态）
[sshd]
enabled  = true
port     = ssh
filter   = sshd
logpath  = /var/log/auth.log
maxretry = 5

# 加固后形态：连接即断开（需自研 filter —— 内置模式均不覆盖，见
# scripts/deploy/fail2ban-sshd-closed.conf 的实测说明与验证方法）
[sshd-closed]
enabled  = true
port     = ssh
filter   = sshd-closed
logpath  = /var/log/auth.log
maxretry = 8
findtime = 1800
bantime  = 7200
